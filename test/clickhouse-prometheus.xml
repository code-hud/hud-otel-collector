<!-- Prometheus remote write and PromQL on the HTTP port (/prometheus/api/v1/write, /query, ...), for the TimeSeries
     table and test/timeseries.yaml. Requests name the table (?database=...&table=metrics) and authenticate like any
     HTTP request. Self-managed only: on Cloud the private preview configures it. -->
<clickhouse>
    <http_handlers>
        <defaults/>
        <rule>
            <url_prefix>/prometheus/api/v1</url_prefix>
            <handler>
                <type>prometheus_api_v1</type>
            </handler>
        </rule>
    </http_handlers>
</clickhouse>
